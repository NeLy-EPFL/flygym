# Generated by scripts/build_wasm_viewer_assets.py and regenerated on every model
# change (39 STL meshes + model_meta.json -- heavy, churning binaries). Kept out
# of the main branch; scripts/dev/push_doc_site.sh regenerates these and mkdocs
# bundles them into the site, so they are only ever published to the gh-pages
# (orphan, force-pushed) branch. Run the build script once to preview locally.
/assets/

# Vendored third-party binaries (MuJoCo WASM + Three.js). Heavy and not meant
# to be tracked in git; see README.md for how to obtain them. The push script
# (scripts/dev/push_doc_site.sh) checks they exist before running mkdocs, which
# then picks them up from disk and bundles them into the gh-pages site.
/vendor/
